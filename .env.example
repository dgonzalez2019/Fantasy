# Required for the AI assistant. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# PORT=3000
# ROTOBOT_MODEL=claude-opus-5

# Yahoo login. Register a free app once at https://developer.yahoo.com/apps/create/
# with Fantasy Sports "Read" permission. Set these and the Settings tab becomes a
# single "Log in with Yahoo" button. Yahoo requires an HTTPS redirect URI, so for
# local use point it at a tunnel (e.g. ngrok) that forwards to this server.
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=https://your-tunnel.ngrok.io/api/accounts/yahoo/callback

# ESPN needs no config — "Log in with ESPN" opens ESPN's own login page.

# Set to 1 to run against built-in sample data instead of the live fantasy APIs.
# ROTOBOT_MOCK=1
